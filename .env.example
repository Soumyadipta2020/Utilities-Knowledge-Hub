# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Query Router Mode: deterministic (0 tokens, instant) or llm (uses CLASSIFIER_MODEL_NAME)
ROUTER_MODE=deterministic
CLASSIFIER_MODEL_NAME=meta-llama/llama-3-8b-instruct:free
SLM_MODEL_NAME=meta-llama/llama-3-8b-instruct:free
LLM_MODEL_NAME=google/gemini-pro-1.5-exp
SLM_FALLBACK_MODEL_NAME=nvidia/nemotron-3.5-lightning:free
LLM_FALLBACK_MODEL_NAME=anthropic/claude-3-haiku
